# PostgreSQL (Docker: docker compose up -d)
DATABASE_URI=postgresql://payload:payload@localhost:5432/hybrid_hit

# Payload — use a long random string in production
PAYLOAD_SECRET=change-me-to-a-secure-random-string-min-32-chars

# Next.js public URL (used for CORS / links)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional: auto-run seed on first dev start (set to true once, then false)
SEED_ON_START=false

# Default admin created by seed (change after first login)
SEED_ADMIN_EMAIL=admin@hybridhit.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# Demo athlete (optional)
SEED_ATHLETE_EMAIL=athlete@hybridhit.local
SEED_ATHLETE_PASSWORD=Athlete123!
